# Node / Next.js build tooling for the marketing+docs site.
# Kept out of the product npm tarball (R-001) — the package is published
# from cli/, so site/ is already a sibling of the package; this file keeps
# the site's own build output out of git.
/node_modules
/.next
/out
/.vercel
/.source
*.tsbuildinfo
next-env.d.ts

# Derived reference pages generated at build time from sibling repo files
# (D-005, T-003). Single-sourced from skills/*/SKILL.md and
# docs/CONVENTIONS-SPEC.md — regenerated on every dev/build, never committed.
/content/docs/pipeline/skills
/content/docs/record-conventions/records
